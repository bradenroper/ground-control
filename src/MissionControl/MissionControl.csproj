<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms is referenced only for NotifyIcon (the tray icon); it ships with the
         Windows Desktop runtime, so this still adds no external packages. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <AssemblyName>MissionControl</AssemblyName>
    <RootNamespace>MissionControl</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <Version>1.0.0</Version>
    <Product>Mission Control</Product>
    <Company>Braden Roper</Company>
    <Copyright>Copyright © 2026 Braden Roper</Copyright>
    <Description>macOS-style Mission Control for Windows</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WFO0003 asks us to move the DPI settings out of the manifest, but this is a WPF app
         that needs PerMonitorV2 declared there: thumbnail rects are physical pixels. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <!-- WinForms' implicit usings collide with WPF's types (Application, MessageBox, Point…).
       Drop them and qualify the few WinForms references explicitly instead. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Loaded at runtime for the tray icon via pack://application:,,,/Resources/app.ico -->
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

</Project>
