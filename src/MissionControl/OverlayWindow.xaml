<Window x:Class="MissionControl.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="#FF15151B">

    <!-- DWM thumbnails are drawn by the compositor on top of this WPF content within
         their rectangles, so the selection chrome lives in the inset gap around each
         thumbnail (the highlight ring) and below it (the title pill). -->
    <Canvas x:Name="OverlayCanvas">
        <Border x:Name="Highlight"
                Visibility="Collapsed"
                BorderBrush="#FF3B9EFF"
                BorderThickness="3"
                CornerRadius="8"
                Background="#223B9EFF"/>

        <Border x:Name="TitleBox"
                Visibility="Collapsed"
                Background="#CC000000"
                CornerRadius="4"
                Padding="10,4">
            <TextBlock x:Name="TitleText"
                       Foreground="White"
                       FontSize="13"
                       FontFamily="Segoe UI"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="360"/>
        </Border>
    </Canvas>
</Window>
